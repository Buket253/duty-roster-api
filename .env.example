# MongoDB Atlas bağlantı dizesi
MONGODB_URI=mongodb+srv://<kullanici>:<sifre>@<cluster>.mongodb.net/nobet-sistemi?retryWrites=true&w=majority

# JWT imzalama anahtarı (uzun ve rastgele olmalı)
JWT_SECRET=degistir-bunu-uzun-rastgele-bir-degerle

PORT=4000

# Frontend origin(leri), virgülle ayrılabilir
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Paylaşım linklerinin başına eklenecek adres
PUBLIC_BASE_URL=http://localhost:5173

# seed.js ile oluşturulacak yönetici hesabı
SEED_ADMIN_EMAIL=admin@hastane.local
SEED_ADMIN_PASSWORD=Nobet2025!
